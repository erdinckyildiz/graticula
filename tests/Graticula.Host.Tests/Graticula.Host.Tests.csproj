<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- OverlayWorkerPoolTests runs the real worker: the bound being tested is
         a process being killed, and a fake would test the bookkeeping. -->
    <CopyOverlayWorker>true</CopyOverlayWorker>
    <CopyImportReader>true</CopyImportReader>
    <RootNamespace>Graticula.Host.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Html moved to Graticula.Core.Markup on 2026-10-14 (ADR-023 condition 3); every page builder here uses it. -->
    <Using Include="Graticula.Core.Markup" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Graticula.Host\Graticula.Host.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- One copy of the oracle-corpus query, compiled into both suites that use it.
         Two verbatim copies is what D-46 is about, and one of them was fixed first. -->
    <Compile Include="..\shared\GeometryCorpus.cs" Link="GeometryCorpus.cs" />
    <Compile Include="..\shared\OneSuiteAtATime.cs" Link="OneSuiteAtATime.cs" />
    <Compile Include="..\shared\GeoParquetFixture.cs" Link="GeoParquetFixture.cs" />
    <Compile Include="..\shared\TilePackageReaders.cs" Link="TilePackageReaders.cs" />
    <Compile Include="..\shared\TestPictures.cs" Link="TestPictures.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-176 condition 4: the OGC and W3C schemas an SLD is validated against, offline. Schemas/NOTICE.md. -->
    <None Include="Schemas\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- ADR-191 conditions 3 to 5: small service definitions, written by ServiceDefinitions/make_fixtures.py. -->
    <None Include="ServiceDefinitions\*.sd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
