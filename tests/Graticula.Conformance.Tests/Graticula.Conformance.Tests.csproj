<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Graticula.Conformance.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <!-- A PNG decoder, and only that. This suite drives the server over HTTP and
         references none of our assemblies on purpose; asserting that a drawn map
         carries the colour the tile face publishes needs pixels, and pixels need a
         decoder. NativeDependencyTests confines SkiaSharp to Graticula.Render.Skia
         among the src projects, which is where the port rule applies — a test that
         reads an image is not a second implementation reaching past IMapCanvas. -->
    <PackageReference Include="SkiaSharp" />

    <!-- <b>And the native library, which was missing until 2026-08-25.</b> `SkiaSharp`
         alone is the managed binding; without a native asset package the loader looks for
         `libSkiaSharp.so` beside the framework and finds nothing, which is a
         `TypeInitializationException` on first use rather than a build error. It never
         showed on Windows, where the Windows native asset arrives with the SDK's own
         runtime pack, and it took the first CI run this repository ever completed to say
         so.

         `NoDependencies` rather than the ordinary Linux package, matching what
         [ADR-041](../../docs/adr/ADR-041-the-map-renderer.md) chose for the server: it
         carries its own font and graphics stack, so a runner — or an air-gapped image —
         needs no system packages. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-60: one database-backed suite at a time. See the file for why the
         run settings could not do this and why the lock is a file handle. -->
    <Compile Include="..\shared\OneSuiteAtATime.cs" Link="OneSuiteAtATime.cs" />
  </ItemGroup>

  <!-- No project reference, deliberately. This suite is a client: it may only
       use what a client can see, which is HTTP and JSON. Referencing our own
       types would let a test assert against a constant that the server also
       reads, and the two would agree while both being wrong. -->

</Project>
