<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- OverlayWorkerPoolTests runs the real worker: the bound being tested is
         a process being killed, and a fake would test the bookkeeping. -->
    <CopyOverlayWorker>true</CopyOverlayWorker>
    <RootNamespace>GisServer.Host.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GisServer.Host\GisServer.Host.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- One copy of the oracle-corpus query, compiled into both suites that use it.
         Two verbatim copies is what D-46 is about, and one of them was fixed first. -->
    <Compile Include="..\shared\GeometryCorpus.cs" Link="GeometryCorpus.cs" />
  </ItemGroup>
</Project>
