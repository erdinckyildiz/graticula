<Project>

  <!--
    Settings common to every project. Kept deliberately small.

    Warnings are errors because this codebase's quality mechanism is the written
    record, and a warning nobody reads is the same failure in a different file.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Server GC: measured as the right default in benchmarks/mvt-generation.
       A-037 found allocation, not CPU, is the binding constraint. -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe'">
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>

    <!-- <b>There was a `graticula.runsettings` here for a day, and it did nothing.</b> It set
         `MaxCpuCount` to 1 to stop the database-backed suites contending, which limits parallelism
         *inside one VSTest run* — and `dotnet test` on a solution does not make one run: MSBuild
         invokes the VSTest target per project across as many nodes as it has. Two solution-wide
         runs passed under it and the third failed, which is what a fix that does nothing looks
         like. Removed rather than kept, because a setting nobody can point at an effect of is worse
         than none. The contention is handled where it happens — tests/shared/OneSuiteAtATime.cs —
         and D-60 carries the whole account. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1707 forbids underscores in member names. Underscored test names are
         the convention because they are read as sentences in failure output.
         Suppressed for test projects only; production code keeps the rule. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
