# Keeps the build context small and the image reproducible. Without this the
# context includes every bin/ and obj/ in the tree, which is slow and can leak a
# host-built binary into the image.
**/bin/
**/obj/
.git/
.vs/
.env
benchmarks/
experiments/
docs/
*.md
# Noto Sans CJK, if a checkout has fetched it: the GLYPHS_CJK=1 stage fetches and checks its own
# copy (ADR-100), and 16 MB of context for a build that does not use it is 16 MB for nothing.
tools/fonts/*.otf
