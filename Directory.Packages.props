<Project>

  <!--
    Central package management.

    DEPENDENCY-LICENSES.md rule 1 says a row must be VERIFIED before an ADR
    adopts a dependency. Every row is currently UNVERIFIED and that is recorded
    as deliberate debt D-06, with a repayment trigger: before the first binary
    that bundles a database driver, a GDAL build or a Python wheel set.

    Nothing below is bundled yet. When the first one is, D-06 comes due.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Geometry — Tier 2, and in a separate process">
    <!-- NetTopologySuite: BSD-3-Clause, compatible with our Apache-2.0
         outbound. Referenced by Graticula.Overlay.Worker and by nothing else,
         which is not tidiness: benchmarks/geometry-overlay measured a
         6,408-vertex adversarial input costing 153 seconds and 16.7 GB, and
         OverlayNG cannot be interrupted. Keeping the library out of the server
         process is what makes the cost killable (Q-97, ADR-022 §9). -->
    <PackageVersion Include="NetTopologySuite" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup Label="Formats — Tier 2, and in a separate process for the same reason as geometry">
    <!-- GDAL through its managed bindings, referenced by Graticula.Import.Reader and by nothing
         else. ADR-037 §5a, which reversed that ADR's own Python worker on the day it was written:
         once GDAL is acceptable, .NET needs a binding rather than a parser, and a second language
         runtime buys nothing. Measured on the owner's own geodatabases — 0.06s against the Python
         worker's 0.29s for the same layer.

         <b>Out of the server process, and the reason is the same argument NetTopologySuite's row
         makes.</b> This parses a file somebody else chose. ADR-009 §2.2's original words are that
         keeping GDAL out of the serving process "removes an untrusted-file parser from the process
         that serves public requests" — a child process is what makes that true here, since the
         package is now in the server image.

         <b>D-06 is due, and this row is the trigger firing.</b> The header of this file names it:
         repayment comes "before the first binary that bundles a database driver, a GDAL build or a
         Python wheel set." This is that binary. GDAL's own LICENSE.TXT is a bill of materials —
         MIT-style core beside BSD, public-domain, Apache-2.0 Esri components, ISC, Info-ZIP and
         Qhull — so what must be enumerated is the *driver set this build carries*, not "GDAL".

         MaxRev.Gdal.Core is MIT; the native payload it carries is GDAL's own bill. The runtime
         package is per platform and both are listed because the development machine is Windows and
         the deployment is Linux (ADR-016 §2). -->
    <PackageVersion Include="MaxRev.Gdal.Core" Version="3.13.1.534" />
    <PackageVersion Include="MaxRev.Gdal.WindowsRuntime.Minimal" Version="3.13.1.534" />
    <PackageVersion Include="MaxRev.Gdal.LinuxRuntime.Minimal" Version="3.13.1.534" />
  </ItemGroup>

  <ItemGroup Label="Data access — Tier 2, adapters only">
    <!-- Npgsql: PostgreSQL License (BSD-style), compatible with our Apache-2.0
         outbound. Referenced only by Graticula.Platform.Postgres; the
         architecture test fails the build if it reaches Tier 1.
         D-06's trigger is the first binary that BUNDLES a driver, not the first
         reference, so it is not yet due — but the row in DEPENDENCY-LICENSES.md
         is now real rather than hypothetical. -->
    <PackageVersion Include="Npgsql" Version="9.0.2" />
    <!-- Argon2id. ADR-015 §5 names the algorithm; .NET has no implementation of
         it, and writing one is the least defensible thing we could do with this
         budget — a wrong Argon2id verifies against itself perfectly while being
         far weaker than intended, so testing does not catch it.
         MIT, managed, no native payload. Behind IPasswordHasher (Tier 1) so the
         choice is replaceable: this is a small community package holding the
         single most security-critical primitive in the server, and that is worth
         saying out loud rather than discovering later. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- FakeTimeProvider. Session expiry and rate-limit windows are time
         behaviour, and the alternative to a controllable clock is a test that
         sleeps: slow, flaky, and unable to test a 15-minute window at all. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
  </ItemGroup>

</Project>
