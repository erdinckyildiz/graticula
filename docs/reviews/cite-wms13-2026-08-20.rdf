            <dct:title>invalid-info_format</dct:title>
            <dct:description>When a GetFeatureInfo request is made with an invalid INFO_FORMAT parameter, then the server returns an exception (code=InvalidFormat).</dct:description>
          </earl:TestCase>
        </dct:hasPart>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17890_1/d1e9981_1/d1e10025_1#each-info_format">
            <dct:title>each-info_format</dct:title>
            <dct:description>For format &amp;quot;text/plain&amp;quot;, when the INFO_FORMAT parameter is set to that format, the MIME type of the response matches that format.</dct:description>
          </earl:TestCase>
        </dct:hasPart>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17890_1/d1e9981_1/d1e10025_2#each-info_format">
            <dct:title>each-info_format</dct:title>
            <dct:description>For format &amp;quot;application/json&amp;quot;, when the INFO_FORMAT parameter is set to that format, the MIME type of the response matches that format.</dct:description>
          </earl:TestCase>
        </dct:hasPart>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17890_1/d1e9981_1/d1e10025_3#each-info_format">
            <dct:title>each-info_format</dct:title>
