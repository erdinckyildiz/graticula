        <earl:outcome rdf:resource="http://www.w3.org/ns/earl#passed"/>
      </earl:TestResult>
    </earl:result>
    <earl:test>
      <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1#getmap">
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1#layers">
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3630_1#first-layer-invalid">
                <dct:title>first-layer-invalid</dct:title>
                <dct:description>When a GetMap request contains two layers where the first is invalid and the second is valid, then the response is an exception (code=LayerNotDefined).</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:description>The LAYERS parameter behaves properly.</dct:description>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_7#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;tr_il&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3626_1#three-layers">
                <dct:title>three-layers</dct:title>
                <dct:description>When a GetMap request contains three valid layer names (separated by commas), then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3635_1#layerlimit">
                <dct:title>layerlimit</dct:title>
                <dct:description>If the service advertises a LayerLimit, it can handle a GetMap request that includes that many layers.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_12#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;tr_yol&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_8#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;tr_ilce&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3624_1#two-layers">
                <dct:title>two-layers</dct:title>
                <dct:description>When a GetMap request contains two valid layer names (separated by a comma), then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_10#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;tr_ref&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:title>layers</dct:title>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3632_1#second-layer-invalid">
                <dct:title>second-layer-invalid</dct:title>
                <dct:description>When a GetMap request contains two layers where the first is valid and the second is invalid, then the response is an exception (code=LayerNotDefined).</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_11#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;tr_yer&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_9#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;tr_kara&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_3#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;look_EarlyAlert_routes&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3628_1#invalid-layer">
                <dct:title>invalid-layer</dct:title>
                <dct:description>When the layer in a GetMap request is invalid, then the response is an exception (code=LayerNotDefined).</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_5#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;look_editable&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_13#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;wms_time_demo&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_1#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;look_buildings&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_6#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;look_parcels&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_2#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;look_EarlyAlert_sites&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_4#each-layer">
                <dct:title>each-layer</dct:title>
                <dct:description>For layer &amp;quot;look_EarlyAlert_reports&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
          </earl:TestCase>
        </dct:hasPart>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3465_1#format">
            <dct:title>format</dct:title>
            <dct:description>The FORMAT parameter behaves properly.</dct:description>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3465_1/d1e3595_1#invalid-format">
                <dct:title>invalid-format</dct:title>
                <dct:description>When a GetMap request contains a Format that is not advertised, then the server throws a Service Exception (code=InvalidFormat).</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3465_1/d1e3601_1#each-format">
                <dct:title>each-format</dct:title>
                <dct:description>For format &amp;quot;image/png&amp;quot;, when the FORMAT parameter is set to that format, the MIME type of the response matches that format.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3465_1/d1e3601_2#each-format">
                <dct:title>each-format</dct:title>
                <dct:description>For format &amp;quot;image/jpeg&amp;quot;, when the FORMAT parameter is set to that format, the MIME type of the response matches that format.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
          </earl:TestCase>
        </dct:hasPart>
        <dct:title>getmap</dct:title>
        <dct:description>The GetMap request behaves properly.</dct:description>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3473_1#styles">
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3692_1#styles-default-commas">
                <dct:title>styles-default-commas</dct:title>
                <dct:description>When a GetMap request contains multiple layers and requests all layers to be shown in the default style by using null values between commas (as in &amp;quot;STYLES=,,,&amp;quot;), then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart rdf:resource="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3690_1#styles-default-multiple-layers"/>
            <dct:hasPart rdf:resource="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3685_1#invalid-style"/>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3705_1#each-style">
                <dct:title>each-style</dct:title>
                <dct:description>For style &amp;quot;default&amp;quot;, when the STYLES parameter is set to that style name, the MIME type of the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3696_1#first-style-invalid">
                <dct:title>first-style-invalid</dct:title>
                <dct:description>When a GetMap request contains two layers, where the first style is not valid and the second style is, then the response is an exception (code=StyleNotDefined).</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3694_1#styles-some-default">
                <dct:title>styles-some-default</dct:title>
                <dct:description>When a GetMap request contains multiple layers and a mixture of named and default styles (as in &amp;quot;STYLES=style1,,style2,,&amp;quot;), then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:title>styles</dct:title>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3698_1#second-style-invalid">
                <dct:title>second-style-invalid</dct:title>
                <dct:description>When a GetMap request contains two layers, where the first style is valid and the second style is not, then the response is an exception (code=StyleNotDefined).</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3679_1#styles-inherited">
                <dct:title>styles-inherited</dct:title>
                <dct:description>When a GetMap request contains a single layer and a single style where the style is inherited by the layer in the capabilities document, then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart rdf:resource="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3688_1#styles-default-single-layer"/>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3681_1#two-styles">
                <dct:title>two-styles</dct:title>
                <dct:description>When a GetMap request contains two valid layers and two valid styles (separated by a comma), then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:description>The STYLES parameter behaves properly.</dct:description>
            <dct:hasPart rdf:resource="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3683_1#three-styles"/>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3473_1/d1e3677_1#styles-direct">
                <dct:title>styles-direct</dct:title>
                <dct:description>When a GetMap request contains a single layer and a single style where the style is contained directly in the layer in the capabilities document, then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
          </earl:TestCase>
        </dct:hasPart>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3479_1#version">
            <dct:title>version</dct:title>
            <dct:description>The VERSION parameter behaves properly.</dct:description>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3479_1/d1e3759_1#no-version">
                <dct:title>no-version</dct:title>
                <dct:description>When a GetMap request does not contain version, then the response contains exception report.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
          </earl:TestCase>
        </dct:hasPart>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3456_1#bbox">
            <dct:description>The BBOX parameter behaves properly.</dct:description>
            <dct:hasPart rdf:resource="s0004/d1e17802_1/d1e17884_1/d1e3456_1/d1e3503_1#bbox-minx-gt-maxx"/>
            <dct:hasPart rdf:resource="s0004/d1e17802_1/d1e17884_1/d1e3456_1/d1e3501_1#bbox-above-scale"/>
            <dct:hasPart rdf:resource="s0004/d1e17802_1/d1e17884_1/d1e3456_1/d1e3506_1#bbox-minx-eq-maxx"/>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3456_1/d1e3512_1#bbox-no-overlap">
                <dct:title>bbox-no-overlap</dct:title>
                <dct:description>When a request contains a Bounding Box whose area does not overlap at all with the BoundingBox advertised, then the server returns empty content.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:title>bbox</dct:title>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3456_1/d1e3495_1#bbox-direct">
                <dct:title>bbox-direct</dct:title>
                <dct:description>When a GetMap request contains a layer whose BoundingBox is contained directly in the layer, then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3456_1/d1e3510_1#bbox-miny-eq-maxy">
                <dct:title>bbox-miny-eq-maxy</dct:title>
                <dct:description>When the BBOX parameter's minimum Y is equal to the maximum Y, then the server throws an exception.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3456_1/d1e3514_1#bbox-outside-crs">
                <dct:title>bbox-outside-crs</dct:title>
                <dct:description>When a request contains a Bounding Box that falls outside of the defined range of the CRS, then the server returns empty content for the area.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3456_1/d1e3497_1#bbox-inherited">
                <dct:title>bbox-inherited</dct:title>
                <dct:description>When a GetMap request contains a layer whose BoundingBox is inherited from a parent layer, then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3456_1/d1e3499_1#bbox-below-scale">
                <dct:title>bbox-below-scale</dct:title>
                <dct:description>When a map is requested where the scale is below the appropriate range as indicated by the MinScaleDenominator element, then the response is not an exception.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart rdf:resource="s0004/d1e17802_1/d1e17884_1/d1e3456_1/d1e3508_1#bbox-miny-gt-maxy"/>
          </earl:TestCase>
        </dct:hasPart>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3477_1#width-and-height">
            <dct:title>width-and-height</dct:title>
            <dct:description>The WIDTH and HEIGHT parameters behaves properly.</dct:description>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3477_1/d1e3743_1#large-size">
                <dct:title>large-size</dct:title>
                <dct:description>When a request is made for a large map (1024x768 or largest map supported), the image returned is exactly the size requested.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3477_1/d1e3745_1#small-size">
                <dct:title>small-size</dct:title>
                <dct:description>When a request is made with WIDTH=8 and HEIGHT=5, the image returned is exactly the size requested.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
          </earl:TestCase>
        </dct:hasPart>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3458_1#crs">
            <dct:title>crs</dct:title>
            <dct:description>The CRS parameter behaves properly.</dct:description>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3458_1/d1e3530_1#crs-direct">
                <dct:title>crs-direct</dct:title>
                <dct:description>When a GetMap request contains a single layer and a CRS where the CRS is contained directly in the layer in the capabilities document, then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3458_1/d1e3532_1#crs-inherited">
                <dct:title>crs-inherited</dct:title>
                <dct:description>When a GetMap request contains a single layer and a CRS where the CRS is inherited from a parent layer in the capabilities document, then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3458_1/d1e3534_1#invalid-crs">
                <dct:title>invalid-crs</dct:title>
                <dct:description>When the CRS parameter in a GetMap request contains a CRS that is not valid for any of the layers being requested, then the server shall throw a Service Exception (code=InvalidCRS).</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3458_1/d1e3542_1#each-crs">
                <dct:title>each-crs</dct:title>
                <dct:description>For CRS &amp;quot;EPSG:4326&amp;quot;, when the CRS parameter is set to that CRS, then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3458_1/d1e3542_2#each-crs">
                <dct:title>each-crs</dct:title>
                <dct:description>For CRS &amp;quot;EPSG:3857&amp;quot;, when the CRS parameter is set to that CRS, then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3458_1/d1e3542_3#each-crs">
                <dct:title>each-crs</dct:title>
                <dct:description>For CRS &amp;quot;CRS:84&amp;quot;, when the CRS parameter is set to that CRS, then the response is valid.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
          </earl:TestCase>
        </dct:hasPart>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3463_1#exceptions">
            <dct:title>exceptions</dct:title>
            <dct:description>The EXCEPTIONS parameter behaves properly.</dct:description>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3463_1/d1e3565_1#exceptions-default">
                <dct:title>exceptions-default</dct:title>
                <dct:description>When an exception is raised without specifying the EXCEPTIONS parameter, then the response is a valid exception with a Content-type header of text/xml.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3463_1/d1e3567_1#exceptions-xml">
                <dct:title>exceptions-xml</dct:title>
                <dct:description>When an exception is raised and EXCEPTIONS=XML, then the response is a valid exception with a Content-type header of text/xml.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
          </earl:TestCase>
        </dct:hasPart>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3475_1#transparent">
            <dct:title>transparent</dct:title>
            <dct:description>The TRANSPARENT parameter behaves properly.</dct:description>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3475_1/d1e3725_1#transparent-default">
                <dct:title>transparent-default</dct:title>
                <dct:description>When a GetMap request is made with no TRANSPARENT parameter and a FORMAT that supports transparency over a layer that is not opaque, then the response contains no transparent pixels.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3475_1/d1e3727_1#transparent-false">
                <dct:title>transparent-false</dct:title>
                <dct:description>When a GetMap request is made with TRANSPARENT=FALSE and a FORMAT that supports transparency over a layer that is not opaque, then the response contains no transparent pixels.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17884_1/d1e3475_1/d1e3729_1#transparent-opaque-layer">
                <dct:title>transparent-opaque-layer</dct:title>
                <dct:description>Clients may request TRANSPARENT=TRUE on a layer that is opaque.</dct:description>
              </earl:TestCase>
            </dct:hasPart>
          </earl:TestCase>
        </dct:hasPart>
      </earl:TestCase>
    </earl:test>
  </earl:Assertion>
