            <dct:description>The MIME-type returned for the LegendURL for Style default in Layer look_EarlyAlert_reports is image/png.</dct:description>
          </earl:TestCase>
        </dct:hasPart>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17877_1/d1e1366_1/d1e1500_1/d1e2888_13#resource-format">
