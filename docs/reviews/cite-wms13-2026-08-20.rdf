    <earl:result>
      <earl:TestResult rdf:about="result-8">
        <dct:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-08-20T10:46:59.462Z</dct:date>
        <earl:outcome rdf:resource="http://www.w3.org/ns/earl#passed"/>
        <cite:message>
          <http:Request>
            <http:methodName>get</http:methodName>
            <http:requestURI>https://DESKTOP-M804G0L:8443/wms?VeRsIoN=1.3.0&amp;ReQuEsT=%47%65%74%43%61%70%61%62%69%6C%69%74%69%65%73&amp;SeRvIcE=WMS</http:requestURI>
            <http:resp>
              <http:Response>
                <http:body>
                  <cnt:ContentAsXML>
                    <cnt:rest>&lt;response xmlns:xi="http://www.w3.org/2001/XInclude"&gt;
         &lt;parser/&gt;
         &lt;content&gt;
            &lt;WMS_Capabilities xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.3.0" xsi:schemaLocation="http://www.opengis.net/wms http://schemas.opengis.net/wms/1.3.0/capabilities_1_3_0.xsd"&gt;
               &lt;Service&gt;
                  &lt;Name&gt;WMS&lt;/Name&gt;
                  &lt;Title&gt;Graticula&lt;/Title&gt;
                  &lt;Abstract&gt;Maps drawn from this server's own published layers, using each layer's stored symbology. Read-only.&lt;/Abstract&gt;
                  &lt;OnlineResource xlink:href="https://DESKTOP-M804G0L:8443/wms" xlink:type="simple"/&gt;
                  &lt;MaxWidth&gt;4096&lt;/MaxWidth&gt;
                  &lt;MaxHeight&gt;4096&lt;/MaxHeight&gt;
               &lt;/Service&gt;
               &lt;Capability&gt;
                  &lt;Request&gt;
                     &lt;GetCapabilities&gt;
                        &lt;Format&gt;text/xml&lt;/Format&gt;
                        &lt;DCPType&gt;
                           &lt;HTTP&gt;
                              &lt;Get&gt;
                                 &lt;OnlineResource xlink:href="https://DESKTOP-M804G0L:8443/wms?" xlink:type="simple"/&gt;
                              &lt;/Get&gt;
                           &lt;/HTTP&gt;
                        &lt;/DCPType&gt;
                     &lt;/GetCapabilities&gt;
                     &lt;GetMap&gt;
                        &lt;Format&gt;image/png&lt;/Format&gt;
                        &lt;Format&gt;image/jpeg&lt;/Format&gt;
                        &lt;DCPType&gt;
                           &lt;HTTP&gt;
                              &lt;Get&gt;
                                 &lt;OnlineResource xlink:href="https://DESKTOP-M804G0L:8443/wms?" xlink:type="simple"/&gt;
                              &lt;/Get&gt;
                           &lt;/HTTP&gt;
                        &lt;/DCPType&gt;
                     &lt;/GetMap&gt;
                     &lt;GetFeatureInfo&gt;
                        &lt;Format&gt;text/plain&lt;/Format&gt;
                        &lt;Format&gt;application/json&lt;/Format&gt;
                        &lt;Format&gt;text/html&lt;/Format&gt;
                        &lt;DCPType&gt;
                           &lt;HTTP&gt;
                              &lt;Get&gt;
                                 &lt;OnlineResource xlink:href="https://DESKTOP-M804G0L:8443/wms?" xlink:type="simple"/&gt;
                              &lt;/Get&gt;
                           &lt;/HTTP&gt;
                        &lt;/DCPType&gt;
                     &lt;/GetFeatureInfo&gt;
                  &lt;/Request&gt;
                  &lt;Exception&gt;
                     &lt;Format&gt;XML&lt;/Format&gt;
                  &lt;/Exception&gt;
                  &lt;Layer&gt;
                     &lt;Title&gt;Graticula&lt;/Title&gt;
                     &lt;CRS&gt;EPSG:4326&lt;/CRS&gt;
                     &lt;CRS&gt;EPSG:3857&lt;/CRS&gt;
                     &lt;CRS&gt;CRS:84&lt;/CRS&gt;
                     &lt;EX_GeographicBoundingBox&gt;
                        &lt;westBoundLongitude&gt;24.7368984222&lt;/westBoundLongitude&gt;
                        &lt;eastBoundLongitude&gt;45.5565032959&lt;/eastBoundLongitude&gt;
                        &lt;southBoundLatitude&gt;34.8977966309&lt;/southBoundLatitude&gt;
                        &lt;northBoundLatitude&gt;43.7591056824&lt;/northBoundLatitude&gt;
                     &lt;/EX_GeographicBoundingBox&gt;
                     &lt;Layer queryable="1"&gt;
                        &lt;Name&gt;look_buildings&lt;/Name&gt;
                        &lt;Title&gt;hosted/look_buildings — look_buildings&lt;/Title&gt;
                        &lt;CRS&gt;EPSG:3857&lt;/CRS&gt;
                        &lt;EX_GeographicBoundingBox&gt;
                           &lt;westBoundLongitude&gt;32.8585764625&lt;/westBoundLongitude&gt;
                           &lt;eastBoundLongitude&gt;32.9187635866&lt;/eastBoundLongitude&gt;
                           &lt;southBoundLatitude&gt;39.9790613616&lt;/southBoundLatitude&gt;
                           &lt;northBoundLatitude&gt;40.0251659433&lt;/northBoundLatitude&gt;
                        &lt;/EX_GeographicBoundingBox&gt;
                        &lt;BoundingBox CRS="EPSG:3857" maxx="3664500" maxy="4869600" minx="3657800" miny="4862900"/&gt;
                        &lt;Style&gt;
                           &lt;Name&gt;default&lt;/Name&gt;
                           &lt;Title&gt;Default&lt;/Title&gt;
                           &lt;LegendURL height="20" width="20"&gt;
                              &lt;Format&gt;image/png&lt;/Format&gt;
                              &lt;OnlineResource xlink:href="https://DESKTOP-M804G0L:8443/wms?service=WMS&amp;amp;version=1.3.0&amp;amp;request=GetLegendGraphic&amp;amp;layer=look_buildings&amp;amp;format=image/png" xlink:type="simple"/&gt;
                           &lt;/LegendURL&gt;
                        &lt;/Style&gt;
                     &lt;/Layer&gt;
                     &lt;Layer queryable="1"&gt;
                        &lt;Name&gt;look_EarlyAlert_sites&lt;/Name&gt;
                        &lt;Title&gt;hosted/look_EarlyAlert — look_EarlyAlert_sites&lt;/Title&gt;
                        &lt;CRS&gt;EPSG:3857&lt;/CRS&gt;
                        &lt;EX_GeographicBoundingBox&gt;
                           &lt;westBoundLongitude&gt;32.8585764625&lt;/westBoundLongitude&gt;
                           &lt;eastBoundLongitude&gt;32.8990006503&lt;/eastBoundLongitude&gt;
