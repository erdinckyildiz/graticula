      <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17877_1/d1e1366_1/d1e1500_1#style-legendurls">
        <dct:title>style-legendurls</dct:title>
        <dct:hasPart>
          <earl:TestCase rdf:about="s0004/d1e17802_1/d1e17877_1/d1e1366_1/d1e1500_1/d1e2888_4#resource-format">
