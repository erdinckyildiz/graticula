            <dct:hasPart>
              <earl:TestCase rdf:about="s0001/d1e17821_1/d1e12030_1#getmap">
                <dct:title>getmap</dct:title>
                <dct:description>The GetMap request behaves properly.</dct:description>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17821_1/d1e12030_1/d1e12075_1#bbox">
                    <dct:title>bbox</dct:title>
                    <dct:description>The BBOX parameter behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17821_1/d1e12030_1/d1e12075_1/d1e12139_1#bbox-exponential">
                        <dct:title>bbox-exponential</dct:title>
                        <dct:description>When a GetMap request uses exponential notation values for the BBOX parameter, then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17821_1/d1e12030_1/d1e12075_1/d1e12141_1#bbox-pixel-interpretation">
                        <dct:title>bbox-pixel-interpretation</dct:title>
                        <dct:description>The server interprets the bounding box as going around the &amp;quot;outside&amp;quot; of the pixels of the image rather than through the centers of the border pixels.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17821_1/d1e12030_1/d1e12077_1#bgcolor">
                    <dct:title>bgcolor</dct:title>
                    <dct:description>The BGCOLOR parameter behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17821_1/d1e12030_1/d1e12077_1/d1e12155_1#no-bgcolor">
                        <dct:title>no-bgcolor</dct:title>
                        <dct:description>When a GetMap request is made with no BGCOLOR parameter, then areas which are not covered contain white (0xFFFFFF) pixels.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17821_1/d1e12030_1/d1e12077_1/d1e12157_1#blue-bgcolor">
                        <dct:title>blue-bgcolor</dct:title>
                        <dct:description>When a GetMap request is made with a BGCOLOR parameter, then areas which are not covered are set to the value of BGCOLOR.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17821_1/d1e12030_1/d1e12079_1#transparent">
                    <dct:title>transparent</dct:title>
                    <dct:description>The TRANSPARENT parameter behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17821_1/d1e12030_1/d1e12079_1/d1e12171_1#transparent-true">
                        <dct:title>transparent-true</dct:title>
                        <dct:description>When a GetMap request is made with TRANSPARENT=TRUE and a FORMAT that supports transparency over a BBOX that is not completely covered, then the response contains transparent pixels.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
              </earl:TestCase>
            </dct:hasPart>
            <cite:testsContinue rdf:datatype="http://www.w3.org/2001/XMLSchema#int">0</cite:testsContinue>
          </earl:TestRequirement>
