                        <dct:description>For layer &amp;quot;tm30native&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3467_1/d1e3628_1#invalid-layer">
                        <dct:title>invalid-layer</dct:title>
                        <dct:description>When the layer in a GetMap request is invalid, then the response is an exception (code=LayerNotDefined).</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_8#each-layer">
                        <dct:title>each-layer</dct:title>
                        <dct:description>For layer &amp;quot;osm_shapefile&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_11#each-layer">
                        <dct:title>each-layer</dct:title>
                        <dct:description>For layer &amp;quot;parks&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
