    <earl:test>
      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17875_1/d1e496_1/d1e520_1#negotiate-lower-version">
        <dct:title>negotiate-lower-version</dct:title>
        <dct:description>When a GetCapabilities request is made for version 0.0.0, the response is not higher than 1.3.0.</dct:description>
      </earl:TestCase>
    </earl:test>
