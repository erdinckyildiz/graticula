  <earl:Assertion rdf:about="assert-153">
    <earl:mode rdf:resource="http://www.w3.org/ns/earl#automatic"/>
    <earl:assertedBy rdf:resource="https://github.com/opengeospatial/teamengine"/>
    <earl:subject rdf:resource=""/>
    <earl:result>
      <earl:TestResult rdf:about="result-153">
        <dct:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-08-26T07:29:59.342Z</dct:date>
        <earl:outcome rdf:resource="http://www.w3.org/ns/earl#passed"/>
      </earl:TestResult>
    </earl:result>
    <earl:test rdf:resource="s0001/d1e17802_1/d1e17890_1/d1e9969_1#exceptions"/>
  </earl:Assertion>
  <cite:TestRun>
    <cite:testsSkipped rdf:datatype="http://www.w3.org/2001/XMLSchema#int">0</cite:testsSkipped>
    <cite:testsBestPractice rdf:datatype="http://www.w3.org/2001/XMLSchema#int">0</cite:testsBestPractice>
    <dct:created>2026-08-26T07:29:59.268952111Z</dct:created>
    <cite:requirements>
      <rdf:Seq>
        <rdf:li>
          <earl:TestRequirement rdf:about="data-independent">
            <cite:testsInheritedFailure rdf:datatype="http://www.w3.org/2001/XMLSchema#int">0</cite:testsInheritedFailure>
            <cite:testsBestPractice rdf:datatype="http://www.w3.org/2001/XMLSchema#int">0</cite:testsBestPractice>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1#getmap">
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3458_1#crs">
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3458_1/d1e3532_1#crs-inherited">
                        <dct:title>crs-inherited</dct:title>
                        <dct:description>When a GetMap request contains a single layer and a CRS where the CRS is inherited from a parent layer in the capabilities document, then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3458_1/d1e3542_4#each-crs">
                        <dct:title>each-crs</dct:title>
                        <dct:description>For CRS &amp;quot;EPSG:5254&amp;quot;, when the CRS parameter is set to that CRS, then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:description>The CRS parameter behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3458_1/d1e3534_1#invalid-crs">
                        <dct:title>invalid-crs</dct:title>
                        <dct:description>When the CRS parameter in a GetMap request contains a CRS that is not valid for any of the layers being requested, then the server shall throw a Service Exception (code=InvalidCRS).</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3458_1/d1e3530_1#crs-direct">
                        <dct:title>crs-direct</dct:title>
                        <dct:description>When a GetMap request contains a single layer and a CRS where the CRS is contained directly in the layer in the capabilities document, then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3458_1/d1e3542_3#each-crs">
                        <dct:title>each-crs</dct:title>
                        <dct:description>For CRS &amp;quot;CRS:84&amp;quot;, when the CRS parameter is set to that CRS, then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3458_1/d1e3542_1#each-crs">
                        <dct:title>each-crs</dct:title>
                        <dct:description>For CRS &amp;quot;EPSG:4326&amp;quot;, when the CRS parameter is set to that CRS, then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:title>crs</dct:title>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3458_1/d1e3542_2#each-crs">
                        <dct:title>each-crs</dct:title>
                        <dct:description>For CRS &amp;quot;EPSG:3857&amp;quot;, when the CRS parameter is set to that CRS, then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3465_1#format">
                    <dct:title>format</dct:title>
                    <dct:description>The FORMAT parameter behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3465_1/d1e3595_1#invalid-format">
                        <dct:title>invalid-format</dct:title>
                        <dct:description>When a GetMap request contains a Format that is not advertised, then the server throws a Service Exception (code=InvalidFormat).</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3465_1/d1e3601_1#each-format">
                        <dct:title>each-format</dct:title>
                        <dct:description>For format &amp;quot;image/png&amp;quot;, when the FORMAT parameter is set to that format, the MIME type of the response matches that format.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3465_1/d1e3601_2#each-format">
                        <dct:title>each-format</dct:title>
                        <dct:description>For format &amp;quot;image/jpeg&amp;quot;, when the FORMAT parameter is set to that format, the MIME type of the response matches that format.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3475_1#transparent">
                    <dct:title>transparent</dct:title>
                    <dct:description>The TRANSPARENT parameter behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3475_1/d1e3725_1#transparent-default">
                        <dct:title>transparent-default</dct:title>
                        <dct:description>When a GetMap request is made with no TRANSPARENT parameter and a FORMAT that supports transparency over a layer that is not opaque, then the response contains no transparent pixels.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3475_1/d1e3727_1#transparent-false">
                        <dct:title>transparent-false</dct:title>
                        <dct:description>When a GetMap request is made with TRANSPARENT=FALSE and a FORMAT that supports transparency over a layer that is not opaque, then the response contains no transparent pixels.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3475_1/d1e3729_1#transparent-opaque-layer">
                        <dct:title>transparent-opaque-layer</dct:title>
                        <dct:description>Clients may request TRANSPARENT=TRUE on a layer that is opaque.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3477_1#width-and-height">
                    <dct:title>width-and-height</dct:title>
                    <dct:description>The WIDTH and HEIGHT parameters behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3477_1/d1e3743_1#large-size">
                        <dct:title>large-size</dct:title>
                        <dct:description>When a request is made for a large map (1024x768 or largest map supported), the image returned is exactly the size requested.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3477_1/d1e3745_1#small-size">
                        <dct:title>small-size</dct:title>
                        <dct:description>When a request is made with WIDTH=8 and HEIGHT=5, the image returned is exactly the size requested.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3463_1#exceptions">
                    <dct:title>exceptions</dct:title>
                    <dct:description>The EXCEPTIONS parameter behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3463_1/d1e3565_1#exceptions-default">
                        <dct:title>exceptions-default</dct:title>
                        <dct:description>When an exception is raised without specifying the EXCEPTIONS parameter, then the response is a valid exception with a Content-type header of text/xml.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3463_1/d1e3567_1#exceptions-xml">
                        <dct:title>exceptions-xml</dct:title>
                        <dct:description>When an exception is raised and EXCEPTIONS=XML, then the response is a valid exception with a Content-type header of text/xml.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1#styles">
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3683_1#three-styles">
                        <dct:title>three-styles</dct:title>
                        <dct:description>When a GetMap request contains three valid layers and three valid styles (separated by commas), then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3694_1#styles-some-default">
                        <dct:title>styles-some-default</dct:title>
                        <dct:description>When a GetMap request contains multiple layers and a mixture of named and default styles (as in &amp;quot;STYLES=style1,,style2,,&amp;quot;), then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3688_1#styles-default-single-layer">
                        <dct:title>styles-default-single-layer</dct:title>
                        <dct:description>When a GetMap request contains a single layer and a null style value (as in &amp;quot;STYLES=&amp;quot;), then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3690_1#styles-default-multiple-layers">
                        <dct:title>styles-default-multiple-layers</dct:title>
                        <dct:description>When a GetMap request contains multiple layers and requests all layers to be shown in the default style by using a single null value (as in &amp;quot;STYLES=&amp;quot;), then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3685_1#invalid-style">
                        <dct:title>invalid-style</dct:title>
                        <dct:description>When a GetMap request contains an unadvertised Style, then the response is an exception (code=StyleNotDefined).</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3705_1#each-style">
                        <dct:title>each-style</dct:title>
                        <dct:description>For style &amp;quot;default&amp;quot;, when the STYLES parameter is set to that style name, the MIME type of the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3681_1#two-styles">
                        <dct:title>two-styles</dct:title>
                        <dct:description>When a GetMap request contains two valid layers and two valid styles (separated by a comma), then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3696_1#first-style-invalid">
                        <dct:title>first-style-invalid</dct:title>
                        <dct:description>When a GetMap request contains two layers, where the first style is not valid and the second style is, then the response is an exception (code=StyleNotDefined).</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3679_1#styles-inherited">
                        <dct:title>styles-inherited</dct:title>
                        <dct:description>When a GetMap request contains a single layer and a single style where the style is inherited by the layer in the capabilities document, then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:description>The STYLES parameter behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3677_1#styles-direct">
                        <dct:title>styles-direct</dct:title>
                        <dct:description>When a GetMap request contains a single layer and a single style where the style is contained directly in the layer in the capabilities document, then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3692_1#styles-default-commas">
                        <dct:title>styles-default-commas</dct:title>
                        <dct:description>When a GetMap request contains multiple layers and requests all layers to be shown in the default style by using null values between commas (as in &amp;quot;STYLES=,,,&amp;quot;), then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:title>styles</dct:title>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3473_1/d1e3698_1#second-style-invalid">
                        <dct:title>second-style-invalid</dct:title>
                        <dct:description>When a GetMap request contains two layers, where the first style is valid and the second style is not, then the response is an exception (code=StyleNotDefined).</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
