                        <dct:title>two-layers</dct:title>
                        <dct:description>When a GetMap request contains two valid layer names (separated by a comma), then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_12#each-layer">
                        <dct:title>each-layer</dct:title>
                        <dct:description>For layer &amp;quot;tiles-buildings&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3467_1/d1e3655_9#each-layer">
