                        <dct:description>For layer &amp;quot;owners&amp;quot;, when the LAYERS parameter is set to that layer name, the MIME type of the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3467_1/d1e3630_1#first-layer-invalid">
                        <dct:title>first-layer-invalid</dct:title>
                        <dct:description>When a GetMap request contains two layers where the first is invalid and the second is valid, then the response is an exception (code=LayerNotDefined).</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
