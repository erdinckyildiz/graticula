                <dct:title>getmap</dct:title>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3456_1#bbox">
                    <dct:title>bbox</dct:title>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3456_1/d1e3508_1#bbox-miny-gt-maxy">
                        <dct:title>bbox-miny-gt-maxy</dct:title>
                        <dct:description>When the BBOX parameter's minimum Y is greater than the maximum Y, then the server throws an exception.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3456_1/d1e3512_1#bbox-no-overlap">
                        <dct:title>bbox-no-overlap</dct:title>
                        <dct:description>When a request contains a Bounding Box whose area does not overlap at all with the BoundingBox advertised, then the server returns empty content.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3456_1/d1e3503_1#bbox-minx-gt-maxx">
                        <dct:title>bbox-minx-gt-maxx</dct:title>
                        <dct:description>When the BBOX parameter's minimum X is greater than the maximum X, then the server throws an exception.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3456_1/d1e3501_1#bbox-above-scale">
                        <dct:title>bbox-above-scale</dct:title>
                        <dct:description>When a map is requested where the scale is above the appropriate range as indicated by the MaxScaleDenominator element, then the response is not an exception.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3456_1/d1e3506_1#bbox-minx-eq-maxx">
                        <dct:title>bbox-minx-eq-maxx</dct:title>
                        <dct:description>When the BBOX parameter's minimum X is equal to the maximum X, then the server throws an exception.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:description>The BBOX parameter behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3456_1/d1e3514_1#bbox-outside-crs">
                        <dct:title>bbox-outside-crs</dct:title>
                        <dct:description>When a request contains a Bounding Box that falls outside of the defined range of the CRS, then the server returns empty content for the area.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3456_1/d1e3499_1#bbox-below-scale">
                        <dct:title>bbox-below-scale</dct:title>
                        <dct:description>When a map is requested where the scale is below the appropriate range as indicated by the MinScaleDenominator element, then the response is not an exception.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3456_1/d1e3495_1#bbox-direct">
                        <dct:title>bbox-direct</dct:title>
                        <dct:description>When a GetMap request contains a layer whose BoundingBox is contained directly in the layer, then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3456_1/d1e3497_1#bbox-inherited">
                        <dct:title>bbox-inherited</dct:title>
                        <dct:description>When a GetMap request contains a layer whose BoundingBox is inherited from a parent layer, then the response is valid.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3456_1/d1e3510_1#bbox-miny-eq-maxy">
                        <dct:title>bbox-miny-eq-maxy</dct:title>
                        <dct:description>When the BBOX parameter's minimum Y is equal to the maximum Y, then the server throws an exception.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3479_1#version">
                    <dct:title>version</dct:title>
                    <dct:description>The VERSION parameter behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17884_1/d1e3479_1/d1e3759_1#no-version">
                        <dct:title>no-version</dct:title>
                        <dct:description>When a GetMap request does not contain version, then the response contains exception report.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
              </earl:TestCase>
            </dct:hasPart>
            <cite:testsWarning rdf:datatype="http://www.w3.org/2001/XMLSchema#int">0</cite:testsWarning>
            <cite:testsPassed rdf:datatype="http://www.w3.org/2001/XMLSchema#int">185</cite:testsPassed>
            <cite:testsSkipped rdf:datatype="http://www.w3.org/2001/XMLSchema#int">0</cite:testsSkipped>
            <dct:title>data-independent</dct:title>
            <cite:isBasic>true</cite:isBasic>
            <dct:hasPart>
              <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1#getcapabilities">
                <dct:title>getcapabilities</dct:title>
                <dct:description>The GetCapabilities request behaves properly.</dct:description>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1355_1#requests">
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1355_1/d1e1403_1#no-format">
                        <dct:title>no-format</dct:title>
                        <dct:description>When no FORMAT parameter is supplied, the response is capabilities XML with MIME type text/xml.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1355_1/d1e1405_1#invalid-format">
                        <dct:title>invalid-format</dct:title>
                        <dct:description>When an invalid FORMAT parameter is supplied, the response is capabilities XML with MIME type text/xml.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1355_1/d1e1410_1#updatesequence-current">
                        <dct:title>updatesequence-current</dct:title>
                        <dct:description>When a GetCapabilities request is made with an UPDATESEQUENCE parameter set to the current update sequence value, then the server returns a valid exception (code=CurrentUpdateSequence).</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1355_1/d1e1395_1#each-format">
                        <dct:title>each-format</dct:title>
                        <dct:description>For format &amp;quot;text/xml&amp;quot;, when the FORMAT parameter is set to that format, the MIME type of the response matches that format.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1355_1/d1e1412_1#updatesequence-lower">
                        <dct:title>updatesequence-lower</dct:title>
                        <dct:description>When a GetCapabilities request is made with an UPDATESEQUENCE parameter set to a value lower than the current update sequence value, then the server returns capabilities XML.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1355_1/d1e1407_1#updatesequence-ignored">
                        <dct:title>updatesequence-ignored</dct:title>
                        <dct:description>When no updateSequence number is advertised in the Capabilities XML, The UPDATESEQUENCE parameter is ignored.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:description>Each request parameter behaves properly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1355_1/d1e1417_1#updatesequence-higher">
                        <dct:title>updatesequence-higher</dct:title>
                        <dct:description>When a GetCapabilities request is made with an UPDATESEQUENCE parameter set to a value higher than the current update sequence value, then the server returns an exception (code=InvalidUpdateSequence).</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:title>requests</dct:title>
                  </earl:TestCase>
                </dct:hasPart>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1362_1#xml-validation">
                    <dct:title>xml-validation</dct:title>
                    <dct:description>The Capabilities XML validates.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1362_1/d1e1434_1#normative-schema">
                        <dct:title>normative-schema</dct:title>
                        <dct:description>The normative content of the schema document referred to by the schemaLocation attribute in the capabilities document is identical to the normative content of the on-line schema referred to in Annex E.1.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1362_1/d1e1436_1#validate-using-schemaLocation">
                        <dct:title>validate-using-schemaLocation</dct:title>
                        <dct:description>The response to a GetCapabilities request validates against the schema(s) provided with the schemaLocation attribute.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1364_1#capability-metadata">
                    <dct:title>capability-metadata</dct:title>
                    <dct:description>The capability metadata is advertised correctly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1364_1/d1e1450_1#capability-onlineresource">
                        <dct:title>capability-onlineresource</dct:title>
                        <dct:description>Each OnlineResource URL intended for HTTP Get requests in the capabilities document is a URL prefix</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1364_1/d1e1452_1#capability-xml-getcapabilities-format">
                        <dct:title>capability-xml-getcapabilities-format</dct:title>
                        <dct:description>The server advertises the text/xml format for the GetCapabilities operation.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1364_1/d1e1454_1#capability-xml-exception-format">
                        <dct:title>capability-xml-exception-format</dct:title>
                        <dct:description>The server advertises the XML service exception format.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                  </earl:TestCase>
                </dct:hasPart>
                <dct:hasPart>
                  <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1#layer-properties">
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1479_1#crs-present">
                        <dct:title>crs-present</dct:title>
                        <dct:description>Every named layer in the capabilities document has at least one CRS element that is either stated explicitly or inherited from a parent Layer.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1481_1#crs-for-all-layers">
                        <dct:title>crs-for-all-layers</dct:title>
                        <dct:description>The root layer lists all CRSs that are common to all subsidiary layers.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1498_1#style-unique">
                        <dct:title>style-unique</dct:title>
                        <dct:description>There are no child layers in the capabilities document that redefine a Style with the same name as one inherited from one of its parents.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1502_1#style-stylesheeturls">
                        <dct:title>style-stylesheeturls</dct:title>
                        <dct:description>The metadata for the StyleSheetURL resource in each Style element is correct.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:title>layer-properties</dct:title>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1505_1#style-styleurls">
                        <dct:title>style-styleurls</dct:title>
                        <dct:description>The metadata for the StyleURL resource in each Style element is correct.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1487_1#ex_geobbox-coordinates">
                        <dct:title>ex_geobbox-coordinates</dct:title>
                        <dct:description>For each EX_GeographicBoundingBox element, westBoundLongitude is less than eastBoundLongitude and southBoundLatitude is less than northBoundLatitude.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1496_1#metadataurls">
                        <dct:title>metadataurls</dct:title>
                        <dct:description>For each of the MetadataURL elements in the capabilities document, the MIME-type returned by the resource is the same as the Format element.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1483_1#dataurls">
                        <dct:title>dataurls</dct:title>
                        <dct:description>For each of the DataURL elements in the capabilities document, the MIME-type returned by the resource is the same as the Format element.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1472_1#bbox-present">
                        <dct:title>bbox-present</dct:title>
                        <dct:description>Every named layer in the capabilities document has at least one BoundingBox element (direct or inherited).</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1494_1#identifier-matches-authorityurl">
                        <dct:title>identifier-matches-authorityurl</dct:title>
                        <dct:description>There are no Layer elements in the capabilities document that declare an Identifier without also declaring or inheriting a corresponding AuthorityURL.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:description>The layer properties are advertised correctly.</dct:description>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1470_1#bbox-crs-advertised">
                        <dct:title>bbox-crs-advertised</dct:title>
                        <dct:description>There are no BoundingBoxes provided for a CRS that is not advertised.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1476_1#crs-auto2-declarations">
                        <dct:title>crs-auto2-declarations</dct:title>
                        <dct:description>None of the CRS declarations in the AUTO2 namespace contain factor, longitude, or latitude variables.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1492_1#authorityurl-unique">
                        <dct:title>authorityurl-unique</dct:title>
                        <dct:description>There are no child Layer elements in the capabilities document that define an AuthorityURL with the same name attribute as one inherited from a parent layer.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1489_1#featurelisturls">
                        <dct:title>featurelisturls</dct:title>
                        <dct:description>For each of the FeatureListURL elements in the capabilities document, the MIME-type returned by the resource is the same as the Format element.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
                      <earl:TestCase rdf:about="s0001/d1e17802_1/d1e17877_1/d1e1366_1/d1e1474_1#bbox-distinct-crs">
                        <dct:title>bbox-distinct-crs</dct:title>
                        <dct:description>For each of the layer elements in the capabilities document, each BoundingBox on the layer states a different CRS.</dct:description>
                      </earl:TestCase>
                    </dct:hasPart>
                    <dct:hasPart>
