*.so
*.dylib

# Dependencies
node_modules/
vendor/
.venv/
__pycache__/

# Benchmark and experiment output — methodology and results are committed,
# raw artefacts are not
benchmarks/**/results/raw/
benchmarks/**/*.log

# The server's stdout when it is run with query tracing on
# (benchmarks/feature-query reads its own numbers back out of this).
trace.log
experiments/**/data/
*.pprof
*.heapsnapshot

# Local data — spatial test data is large and is fetched, not committed
data/
*.gpkg
*.mbtiles
*.pmtiles
*.tif
*.tiff
*.shp
*.dbf
*.shx

# Local configuration and secrets
.env
.env.*
*.local.yaml
*.local.json

# <b>Anchored, and it is anchored because the unanchored form hid production
# source for six days.</b> `secrets/` matches a directory of that name at any
# depth and case-insensitively on Windows, so it swallowed
# `src/Graticula.Platform/Secrets/` — the two files that seal every registered
# data source credential were never committed, and a clone of this repository
# could not build. Nothing reported it: an ignored file is not untracked, so
# `git status` says nothing, and the working copy builds. Found on 2026-08-18 by
# deleting the working copy with `git clean -x` and recovering the source from a
# build output. See D-62. A leading slash pins this to the repository root, where
# a deployment's own credential directory would be.
/secrets/

# Editor and OS
.vscode/
.vs/
*.user
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
benchmarks/_tmp/
TestResults/

# A session token written by a manual test
tok
grp_service.html
