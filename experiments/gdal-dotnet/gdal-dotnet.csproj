<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DISPOSABLE. CLAUDE.md §1: /experiments is never promoted. This exists to answer one question
    before ADR-037 is reversed on the strength of a search result — can .NET read the owner's real
    File Geodatabase through GDAL's managed bindings, and can it write GeoParquet?

    Central package management is deliberately off here, so trying a version costs nothing in
    Directory.Packages.props and an answer of "no" leaves no trace in the product's dependency graph.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);CA1852;CS1591;SA0001;CA1305;CA1303</NoWarn>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzers>false</RunAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaxRev.Gdal.Core" Version="3.13.1.534" />
    <PackageReference Include="MaxRev.Gdal.WindowsRuntime.Minimal" Version="3.13.1.534" />
  </ItemGroup>

</Project>
