<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TIER 1. The ArcGIS surface — v1's primary API (Q-88), not a compatibility
    layer bolted on the side.

    No PackageReference: System.Text.Json ships with the framework, so the
    architecture test's base-class-library allow-list covers it. If this project
    ever needs a package, that is a signal to look again rather than to widen the
    list.
  -->

  <PropertyGroup>
    <RootNamespace>Graticula.Api.ArcGis</RootNamespace>
    <AssemblyName>Graticula.Api.ArcGis</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Graticula.Core\Graticula.Core.csproj" />
  </ItemGroup>

</Project>
