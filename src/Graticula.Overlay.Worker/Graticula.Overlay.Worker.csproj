<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TIER 2, and deliberately its own process.

    build-vs-adopt-policy.md §4 permits an established geometry library behind
    our own port interface. This project is that adapter, and it is an
    executable rather than a library for a reason measured rather than argued:
    benchmarks/geometry-overlay found a 6,408-vertex adversarial input costing
    153 seconds and 16.7 GB, and OverlayNG cannot be interrupted. A library
    reference would put that inside the server; a process can be killed.

    NetTopologySuite is therefore referenced HERE AND NOWHERE ELSE. The host
    never loads it, so no overlay can allocate a byte in the server's heap.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Graticula.Overlay.Worker</RootNamespace>
    <AssemblyName>Graticula.Overlay.Worker</AssemblyName>

    <!--
      Server GC would let this process grow to fill the machine, which is the
      failure it exists to prevent. Workstation GC plus the hard limit the host
      sets on the environment keeps it inside its own ceiling.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Graticula.Core\Graticula.Core.csproj" />
  </ItemGroup>

</Project>
