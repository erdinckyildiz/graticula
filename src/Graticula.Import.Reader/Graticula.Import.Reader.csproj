<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TIER 2, and deliberately its own process — the same shape and the same argument as
    Graticula.Overlay.Worker beside it.

    That project is a separate executable because an adversarial geometry cost 153 seconds and
    16.7 GB and OverlayNG cannot be interrupted. This one is separate because it parses a file
    somebody else chose: ADR-009 §2.2's words for keeping GDAL out of the serving process are that it
    "removes an untrusted-file parser from the process that serves public requests", and with the
    package now in the server image (ADR-037 §5a) a child process is what makes that true.

    GDAL is therefore referenced HERE AND NOWHERE ELSE. The host never loads it.

    ADR-037 §5a reversed that ADR's Python worker on the day it was written. Once GDAL is acceptable,
    .NET needs a binding rather than a parser — measured at 0.06s against the Python worker's 0.29s
    on the owner's own geodatabase.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Graticula.Import.Reader</RootNamespace>
    <AssemblyName>Graticula.Import.Reader</AssemblyName>

    <!--
      Same reasoning as the overlay worker's: server GC sizes itself to the machine, and this process
      exists so that a hostile archive cannot take the machine. Workstation GC plus the heap ceiling
      the host sets on the environment keeps it inside its own bound.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!--
      NOT InvariantGlobalization. GDAL and PROJ read their own data files and resolve authority codes;
      the overlay worker can be invariant because it only computes on coordinates, and this one cannot
      because it reads names, aliases and coded domains out of somebody's geodatabase.
    -->
  </PropertyGroup>

  <!--
    <b>GDAL without Poppler — ADR-254, owner decision 2026-11-01 on D-380 ("PDF'siz GDAL'a geç").</b>
    MaxRev.Gdal's payload linked Poppler (GPL-2.0-or-later) into libgdal and into every SWIG wrapper.
    GDAL now comes from a pinned set of conda-forge packages — libgdal-core, the JPEG 2000, NetCDF and
    HDF plugins, and gdal-csharp's wrappers — which tools/gdal-natives.py downloads, checks against the
    SHA-256s in deploy/gdal/gdal-natives.lock.json, and lays out in .gdal/<rid>/. It refuses a closure
    with a GPL library in it, a file named Poppler, PDFium, PoDoFo or librttopo, or a wrapper missing an
    entry point the C# calls. The C# binding is GDAL's own SWIG output, compiled into this assembly.

    GdalRuntimes: the platforms whose libraries go beside the reader, separated by commas. Set it in the
    environment (GdalRuntimes=linux-x64,linux-arm64), because MSBuild's /p: splits a value at commas too. This machine's by default; the
    server image's build asks for both Linux architectures and keeps one per image, as it does for
    DuckDB and Skia. GdalFetch=false when the directory was laid out beforehand (the Docker stage that
    has Python; the SDK image has none).
  -->
  <PropertyGroup>
    <!-- The SWIG output marshals arrays with pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GdalNatives Condition="'$(GdalNatives)' == ''">$(MSBuildThisFileDirectory)../../.gdal/</GdalNatives>
    <GdalFetch Condition="'$(GdalFetch)' == ''">true</GdalFetch>
    <GdalPython Condition="'$(GdalPython)' == '' And '$(OS)' == 'Windows_NT'">python</GdalPython>
    <GdalPython Condition="'$(GdalPython)' == ''">python3</GdalPython>
    <GdalRuntimes Condition="'$(GdalRuntimes)' == '' And '$(OS)' == 'Windows_NT'">win-x64</GdalRuntimes>
    <GdalRuntimes Condition="'$(GdalRuntimes)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</GdalRuntimes>
    <GdalRuntimes Condition="'$(GdalRuntimes)' == ''">linux-x64</GdalRuntimes>
  </PropertyGroup>

  <ItemGroup>
    <GdalRuntime Include="$([MSBuild]::Unescape($(GdalRuntimes.Replace(',', ';'))))" />
  </ItemGroup>

  <Target Name="GdalNatives" BeforeTargets="BeforeBuild;CoreCompile">
    <Exec Condition="'$(GdalFetch)' == 'true'"
          Command="&quot;$(GdalPython)&quot; -I &quot;$(MSBuildThisFileDirectory)../../tools/gdal-natives.py&quot; fetch %(GdalRuntime.Identity) &quot;$(GdalNatives)%(GdalRuntime.Identity)&quot;" />
    <Error Condition="!Exists('$(GdalNatives)%(GdalRuntime.Identity)/.complete')"
           Text="GDAL for %(GdalRuntime.Identity) is not laid out in $(GdalNatives)%(GdalRuntime.Identity). Run tools/gdal-natives.py fetch (ADR-254)." />
    <ItemGroup>
      <!-- The binding's sources are the same for every platform; the first platform's copy is compiled. -->
      <Compile Include="$(GdalNatives)$(GdalRuntimes.Replace(',', ';').Split(';')[0])/csharp/**/*.cs" />
      <_GdalPayload Include="$(GdalNatives)%(GdalRuntime.Identity)/**/*" Exclude="$(GdalNatives)%(GdalRuntime.Identity)/csharp/**;$(GdalNatives)%(GdalRuntime.Identity)/.complete">
        <Runtime>%(GdalRuntime.Identity)</Runtime>
      </_GdalPayload>
      <None Include="@(_GdalPayload)" Link="gdal/%(_GdalPayload.Runtime)/%(_GdalPayload.RecursiveDir)%(_GdalPayload.Filename)%(_GdalPayload.Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!--
      ADR-009 condition 1: a GeoTIFF the server is about to catalogue is opened here first, by the reader the server
      reads it with, so that a file which kills that parser kills this process rather than the serving one. The
      adapter is referenced, not its library: BitMiracle.LibTiff stays Graticula.Raster.Tiff's (NativeDependencyTests).
    -->
    <ProjectReference Include="..\Graticula.Raster.Tiff\Graticula.Raster.Tiff.csproj" />
  </ItemGroup>

</Project>
