<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TIER 2 ADAPTER. This is where the database driver is allowed to be.

    build-vs-adopt-policy.md §4: adopted libraries are permitted, behind our own
    port interface, and no library type may appear in a Tier 1 signature. The
    port is IPlatformSchemaStore in Graticula.Platform; Npgsql lives here and
    nothing outside this project references it.

    tests/Graticula.Architecture.Tests fails the build if that slips.
  -->

  <PropertyGroup>
    <RootNamespace>Graticula.Platform.Postgres</RootNamespace>
    <AssemblyName>Graticula.Platform.Postgres</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Graticula.Platform\Graticula.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
