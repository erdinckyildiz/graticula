<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TIER 2 ADAPTER. Layers served from a registered MySQL database's spatial tables — ADR-208.

    Separate from the PostGIS, DuckDB and Oracle providers for the reason they are separate from each other: a
    different engine and dialect below the same ports. MySqlConnector is referenced here and nowhere else, so no
    MySQL type reaches Core, an endpoint or a writer. Geometry crosses the port as WKB in longitude-latitude order.
  -->

  <PropertyGroup>
    <RootNamespace>Graticula.Providers.MySql</RootNamespace>
    <AssemblyName>Graticula.Providers.MySql</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Graticula.Core\Graticula.Core.csproj" />
    <ProjectReference Include="..\Graticula.Platform\Graticula.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Graticula.Providers.MySql.Tests" />
  </ItemGroup>

</Project>
