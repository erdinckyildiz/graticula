<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The rasteriser adapter — ADR-041 §5.1.

    Its own project because this is the ONLY place in the repository where
    SkiaSharp may be named. build-vs-adopt-policy.md §4 permits a Tier 2 library
    behind our own port; a project boundary is the only version of that rule a
    build can check, and NativeDependencyTests checks it in both directions —
    nobody else references the package, and this project still does.

    Unlike Graticula.Import.Reader and Graticula.Overlay.Worker, this one IS
    reachable from the host: those confine an untrusted-file parser and an
    uninterruptible algorithm to killable child processes, and neither argument
    applies to drawing our own geometry with our own style.
  -->

  <PropertyGroup>
    <RootNamespace>Graticula.Render.Skia</RootNamespace>
    <AssemblyName>Graticula.Render.Skia</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Graticula.Core\Graticula.Core.csproj" />
  </ItemGroup>

  <!--
    The bundled face — D-161, owner decision 2026-08-25: carry Latin, Turkish,
    Greek and Cyrillic; leave CJK to a mount.

    The same file the tile face already uses, and that is the point. ADR-027
    chose DejaVu Sans for the glyph endpoint and tools/make-glyphs.py renders
    its SDF glyphs from exactly this TTF. Adding a second family would have
    meant two licences, two bills of materials, two answers to "which scripts
    does this product draw" — and a WMS map drawn in one typeface beside a
    vector tile of the same layer labelled in another. One font, both faces.

    Measured rather than assumed: this file carries Turkish, Greek, Cyrillic and
    Arabic, and does not carry Han. Its licence is already recorded in
    DEPENDENCY-LICENSES.md and its text ships in tools/fonts/LICENSE-DejaVu.txt.

    Embedded rather than copied beside the assembly. A file on disk is a file a
    deployment can lose, and the failure would be silent in exactly the way this
    exists to prevent: the renderer would fall back to the system face and draw
    boxes again, on a build that claims to carry a font.
  -->
  <!--
    ADR-100, 2026-09-29: the rest of the tile face's stack, so a WMS map and a vector
    tile of the same layer are still labelled from the same fonts now that the tile face
    draws Arabic, Hebrew, Armenian, Georgian, Devanagari, Bengali, Tamil and Thai. The
    list and its order are tools/fonts/stack.json, embedded beside them and read at
    startup, so the two faces cannot disagree about which font a codepoint comes from.
    The optional font in that list, Noto Sans CJK, is not embedded: it is 16 MB, and the
    renderer finds it in the fonts directory beside the server when an image was built
    with it.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\fonts\DejaVuSans.ttf"
                      LogicalName="Graticula.Render.Skia.fonts.DejaVuSans.ttf" />
    <EmbeddedResource Include="..\..\tools\fonts\NotoSans*.ttf"
                      LogicalName="Graticula.Render.Skia.fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\tools\fonts\stack.json"
                      LogicalName="Graticula.Render.Skia.fonts.stack.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <!-- The Linux payloads. NoDependencies carries its own font and graphics
         stack, so an air-gapped image needs no system packages; the other is
         kept because a deployment that has them prefers the smaller one. Both
         are declared so that the confinement rule sees the whole family. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <!-- ADR-100: the shaper, and its Linux payload. -->
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
  </ItemGroup>

</Project>
