<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TIER 1. Written by us, always (build-vs-adopt-policy.md §4).

    This project has NO PackageReference and must never acquire one. The rule is
    enforced by tests/GisServer.Architecture.Tests, which fails the build if any
    assembly outside the base class library appears in this assembly's
    references.

    ADR-003 §6 places three tiers here: provider pushdown first, our own flat
    primitives second, adopted topology third. Tiers 1 and 2 of that scheme live
    in this project. Tier 3 lives behind a port this project declares and an
    adapter project implements.
  -->

  <PropertyGroup>
    <RootNamespace>GisServer</RootNamespace>
    <AssemblyName>GisServer.Core</AssemblyName>
  </PropertyGroup>

</Project>
